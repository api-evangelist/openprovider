          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1beta/tlds",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Search query limit."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Search query offset."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sorts output ASC or DESC."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
