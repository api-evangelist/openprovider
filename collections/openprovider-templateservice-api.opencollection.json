{
  "opencollection": "1.0.0",
  "info": {
    "name": "REST AdditionalData TemplateService API",
    "version": "1.0.0-beta"
  },
  "items": [
    {
      "info": {
        "name": "TemplateService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1beta/dns/templates",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of objects in the output."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Used to retrieve all objects from a certain offset up to the limit."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sorting type (asc/desc)."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field for sorting output. Possible value: name."
              },
              {
                "name": "with_records",
                "value": "",
                "type": "query",
                "description": "Indicates if DNS records should be retrieved."
              },
              {
                "name": "name_pattern",
                "value": "",
                "type": "query",
                "description": "Template name pattern. Wildcard (*)can be used."
              }
            ]
          },
          "docs": "List templates"
        },
        {
          "info": {
            "name": "Create template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1beta/dns/templates"
          },
          "docs": "Create template"
        },
        {
          "info": {
            "name": "Get template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1beta/dns/templates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Template ID"
              }
            ]
          },
          "docs": "Get template"
        },
        {
          "info": {
            "name": "Delete template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1beta/dns/templates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Template ID"
              }
            ]
          },
          "docs": "Delete template"
        }
      ]
    }
  ],
  "bundled": true
